{
  "name": "daymate",
  "version": "1.7.0",
  "description": "A friendly configurable Pebble Time 2 watchface.",
  "author": "Lyle Morris",
  "license": "UNLICENSED",
  "private": true,
  "pebble": {
    "displayName": "DayMate",
