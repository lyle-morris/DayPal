{
  "name": "daymate",
  "version": "1.7.0",
  "description": "A friendly configurable Pebble Time 2 watchface.",
  "author": "Lyle Morris",
  "license": "UNLICENSED",
  "private": true,
  "pebble": {
    "displayName": "DayMate",
    "uuid": "64d3ca97-9d6a-47d0-98e5-0cb9530ad920",
    "sdkVersion": "3",
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "location",
      "health"
    ],
    "messageKeys": {
      "theme": 0,
      "slot_1_metric": 1,
      "slot_2_metric": 2,
      "slot_3_metric": 3,
      "slot_4_metric": 4,
      "show_leading_zero": 5,
      "weather_temp": 10,
      "weather_code": 11,
      "weather_valid": 12,
      "request_weather": 20,
      "settings_ready": 21
    },
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "FONT_ROBOTO_BLACK_90",
          "file": "fonts/Roboto-Black.ttf",
          "characterRegex": "[0-9]"
        },
        {
          "type": "font",
          "name": "FONT_ROBOTO_BOLD_16",
          "file": "fonts/Roboto-Bold.ttf",
          "characterRegex": "[0-9k\\-]"
        },
        {
          "type": "font",
          "name": "FONT_ROBOTO_REGULAR_16",
          "file": "fonts/Roboto-Regular.ttf",
          "characterRegex": "[A-Za-z0-9, ]"
        }
      ]
    }
  }
}
